---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import testimonials from '../data/testimonials.json';
import TestimonialCard from '../components/TestimonialCard.astro';

const services = [
  {
    title: 'Technical Leadership',
    description: 'Guide teams through architectural trade-offs, delivery constraints, and platform decisions with the perspective of two decades building production software.',
  },
  {
    title: 'AI-Assisted Software Delivery',
    description: 'Apply coding agents and LLM workflows where they help: implementation support, review loops, documentation, and repeatable engineering practice.',
  },
  {
    title: 'Agentic Systems Exploration',
    description: 'Shape early agent workflows (clear boundaries, evaluation habits, tool access, operational thinking) before they become production dependencies.',
  },
];
---

<BaseLayout title="Home">
  <section class="hero-section shell">
    <div class="hero-content">
      <div class="hero-visual">
        <img src="/images/carlos.jpg" alt="Carlos Paramio" class="hero-photo" width="360" height="360" />
      </div>
      <div class="hero-text">
        <p class="hero-kicker animate-fade-up">Director of Technology · Avallain</p>
        <h1 class="text-display font-semibold animate-fade-up" style="animation-delay: 80ms;">
          Software architecture for cloud and AI
        </h1>
        <p class="hero-subtitle text-lg text-muted max-w-xl animate-fade-up" style="animation-delay: 160ms;">
          20+ years designing scalable software and cloud platforms. I now apply that architecture discipline to AI-assisted delivery, agent workflows, and systems that need to survive real production constraints.
        </p>
        <div class="hero-actions animate-fade-up" style="animation-delay: 240ms;">
          <a href="/projects" class="btn btn-primary">See selected work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="services-heading">
    <header class="section-heading animate-fade-up">
      <h2 id="services-heading">Cloud systems, technical leadership, and AI-assisted delivery</h2>
      <p class="section-description">
        <strong>Cloud architecture at scale</strong> — Design AWS and SaaS platforms that absorb real traffic, AI workloads, and operational pressure without turning cost or reliability into surprises. Architecture remains the foundation: clear boundaries, resilient platforms, cost awareness, and technical leadership. AI is a new layer in that system, not a replacement for engineering judgment.
      </p>
    </header>
    {services.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 animate-stagger">
        {services.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    )}
  </section>

  <section class="section shell section-divider" aria-labelledby="testimonials-heading">
    <header class="section-heading animate-fade-up">
      <span class="section-kicker">Endorsements</span>
      <h2 id="testimonials-heading">Trusted by teams building real products</h2>
      <p class="section-description">
        Leaders, founders, and engineers I have partnered with across architecture, delivery, and technical decision-making.
      </p>
    </header>

    {testimonials.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 animate-stagger">
        {testimonials.slice(0, 3).map((testimonial) => (
          <TestimonialCard {...testimonial} />
        ))}
      </div>
    ) : (
      <p class="text-muted">What colleagues say about working together.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-block: clamp(4.5rem, 11vw + 1rem, 8.5rem);
  }

  .hero-content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.35fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .hero-visual {
    position: relative;
    justify-self: center;
    flex-shrink: 0;
    width: clamp(240px, 30vw, 360px);
    aspect-ratio: 1 / 1;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    padding: var(--space-2);
    background-color: var(--color-surface-raised);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(1rem - var(--space-2));
  }

  .hero-text {
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
    display: grid;
    gap: var(--space-4);
  }

  .hero-kicker {
    width: fit-content;
    font-size: var(--text-sm);
    letter-spacing: 0;
    font-weight: 600;
    color: var(--color-accent);
    border: 1px solid color-mix(in oklch, var(--color-accent) 28%, transparent);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    background: color-mix(in oklch, var(--color-accent-bg) 70%, transparent);
  }

  .hero-subtitle {
    line-height: 1.75;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.35rem);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: center;
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero-visual {
      order: -1;
      width: min(100%, 200px);
      height: auto;
      justify-self: start;
    }

    .hero-text .text-lg {
      max-width: 100%;
    }
  }
</style>
