<svg class="agent-loop-scope" viewBox="0 0 520 360" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="scope-title">
  <title id="scope-title">Software delivery loop with telemetry signal</title>
  <defs>
    <linearGradient id="scopeTrace" x1="86" y1="0" x2="434" y2="0" gradientUnits="userSpaceOnUse">
      <stop stop-color="var(--color-accent)" stop-opacity="0" />
      <stop offset="0.45" stop-color="var(--color-accent)" stop-opacity="0.9" />
      <stop offset="0.72" stop-color="var(--color-signal)" stop-opacity="0.9" />
      <stop offset="1" stop-color="var(--color-signal)" stop-opacity="0" />
    </linearGradient>
    <filter id="scopeGlow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <g class="scope-grid" opacity="0.42">
    {Array.from({ length: 12 }).map((_, index) => <path d={`M${46 + index * 39} 38V322`} />)}
    {Array.from({ length: 8 }).map((_, index) => <path d={`M42 ${54 + index * 36}H478`} />)}
  </g>

  <path class="scope-frame" d="M58 44H462V316H58V44Z" />
  <path class="scope-axis" d="M86 180H434" />

  <g class="scope-orbit" filter="url(#scopeGlow)">
    <path class="loop loop-back" d="M158 178C158 112 204 78 260 78C316 78 362 112 362 178C362 244 316 282 260 282C204 282 158 244 158 178Z" />
    <path class="loop loop-front" d="M158 178C158 112 204 78 260 78C316 78 362 112 362 178C362 244 316 282 260 282C204 282 158 244 158 178Z" />
  </g>

  <g class="scope-core">
    <circle cx="260" cy="180" r="46" />
    <text x="260" y="171">ARCHITECT</text>
    <text x="260" y="193">CONTROL LOOP</text>
  </g>

  <g class="scope-phases">
    <g transform="translate(238 52)">
      <rect x="0" y="0" width="44" height="22" rx="11" />
      <text x="22" y="15">Shape</text>
    </g>
    <g transform="translate(378 166)">
      <rect x="0" y="0" width="48" height="22" rx="11" />
      <text x="24" y="15">Build</text>
    </g>
    <g transform="translate(232 286)">
      <rect x="0" y="0" width="56" height="22" rx="11" />
      <text x="28" y="15">Verify</text>
    </g>
    <g transform="translate(92 166)">
      <rect x="0" y="0" width="58" height="22" rx="11" />
      <text x="29" y="15">Refine</text>
    </g>
  </g>

  <path class="scope-wave scope-wave-shadow" d="M88 181C108 140 128 222 148 181C168 140 188 222 208 181C228 140 248 222 268 181C288 140 308 222 328 181C348 140 368 222 388 181C408 140 428 222 448 181" />
  <path class="scope-wave" d="M88 181C108 140 128 222 148 181C168 140 188 222 208 181C228 140 248 222 268 181C288 140 308 222 328 181C348 140 368 222 388 181C408 140 428 222 448 181" />

  <g class="scope-beam" filter="url(#scopeGlow)">
    <rect x="86" y="78" width="82" height="204" />
  </g>

  <g class="scope-points" filter="url(#scopeGlow)">
    <circle class="point point-a" cx="260" cy="78" r="5" />
    <circle class="point point-b" cx="362" cy="178" r="5" />
    <circle class="point point-c" cx="260" cy="282" r="5" />
    <circle class="point point-d" cx="158" cy="178" r="5" />
    <circle class="runner" r="6" />
  </g>

  <g class="scope-labels">
    <text x="74" y="34">SYSTEM RHYTHM</text>
    <text x="330" y="34">CLOUD · DELIVERY · AI</text>
    <text x="74" y="340">ARCHITECTURE GUIDES THE LOOP</text>
    <text x="326" y="340">AGENTS ARE ONE SIGNAL</text>
  </g>
</svg>

<style>
  .agent-loop-scope {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .scope-grid path,
  .scope-frame,
  .scope-axis,
  .loop,
  .scope-wave {
    vector-effect: non-scaling-stroke;
  }

  .scope-grid path {
    stroke: color-mix(in oklch, var(--color-accent) 28%, transparent);
    stroke-width: 0.75;
  }

  .scope-frame {
    stroke: color-mix(in oklch, var(--color-accent) 52%, transparent);
    stroke-width: 1.2;
  }

  .scope-axis {
    stroke: color-mix(in oklch, var(--color-text-subtle) 36%, transparent);
    stroke-width: 1;
    stroke-dasharray: 4 8;
  }

  .loop {
    stroke-width: 1.7;
  }

  .loop-back {
    stroke: color-mix(in oklch, var(--color-signal) 20%, transparent);
  }

  .loop-front {
    stroke: var(--color-accent);
    stroke-dasharray: 54 590;
    animation: loop-trace 7s linear infinite;
  }

  .scope-core circle {
    fill: color-mix(in oklch, var(--color-background) 78%, transparent);
    stroke: color-mix(in oklch, var(--color-accent) 46%, transparent);
    stroke-width: 1.2;
  }

  .scope-core text,
  .scope-phases text,
  .scope-labels text {
    font-family: 'Manrope', system-ui, sans-serif;
    text-anchor: middle;
    fill: var(--color-text-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .scope-core text {
    fill: var(--color-text);
    font-size: 12px;
  }

  .scope-phases rect {
    fill: color-mix(in oklch, var(--color-background) 82%, transparent);
    stroke: color-mix(in oklch, var(--color-accent) 40%, transparent);
  }

  .scope-phases text {
    font-size: 10px;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .scope-wave {
    stroke: url(#scopeTrace);
    stroke-width: 2;
    stroke-dasharray: 180 420;
    animation: wave-flow 5.5s linear infinite;
  }

  .scope-wave-shadow {
    stroke: color-mix(in oklch, var(--color-accent) 22%, transparent);
    stroke-width: 8;
    opacity: 0.35;
    filter: blur(5px);
  }

  .scope-beam rect {
    width: 60px;
    fill: color-mix(in oklch, var(--color-signal) 12%, transparent);
    animation: scope-beam 6.5s var(--ease-out-quint) infinite;
  }

  .scope-points circle {
    fill: var(--color-accent);
  }

  .point-b,
  .point-d {
    fill: var(--color-signal) !important;
  }

  .runner {
    fill: var(--color-warm-signal) !important;
    animation: runner-loop 7s linear infinite;
  }

  .scope-labels text {
    text-anchor: start;
    fill: var(--color-text-subtle);
    font-size: 10px;
  }

  @keyframes loop-trace {
    to { stroke-dashoffset: -644; }
  }

  @keyframes wave-flow {
    to { stroke-dashoffset: -600; }
  }

  @keyframes scope-beam {
    0%, 12% { opacity: 0; transform: translateX(0); }
    22%, 72% { opacity: 1; }
    88%, 100% { opacity: 0; transform: translateX(286px); }
  }

  @keyframes runner-loop {
    0% { transform: translate(260px, 78px); }
    25% { transform: translate(362px, 178px); }
    50% { transform: translate(260px, 282px); }
    75% { transform: translate(158px, 178px); }
    100% { transform: translate(260px, 78px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-front,
    .scope-wave,
    .scope-beam rect,
    .runner {
      animation: none;
    }

    .scope-beam rect {
      opacity: 0;
    }
  }
</style>
